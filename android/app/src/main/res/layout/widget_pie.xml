<?xml version="1.0" encoding="utf-8"?>
<!-- Pie de los widgets (EstacionWidget.java): de quién son los datos, cuándo se actualizó y ↻ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="5dp"
        android:contentDescription="@null"
        android:src="@mipmap/ic_launcher_round" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_fuente"
        android:textColor="#8CE2E2E2"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/pie_actualizado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#8CE2E2E2"
        android:textSize="11sp" />

    <ImageView
        android:id="@+id/pie_actualizar"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="2dp"
        android:contentDescription="@string/widget_actualizar"
        android:padding="3dp"
        android:src="@drawable/widget_actualizar" />
</LinearLayout>
